<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="BOLETÍN ACADÉMICO"
            android:textSize="25sp"
            android:textStyle="bold"
            android:padding="16dp"
    android:textColor="@color/texto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta el rendimiento académico de tus estudiantes"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="20dp"
    android:textColor="@color/texto_suave" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar grado"
            android:textStyle="bold"
            android:textSize="16sp"
    android:textColor="@color/texto" />

        <Spinner
            android:id="@+id/spinnerGradoInforme"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="15dp"
    android:background="@drawable/bg_spinner"
    android:paddingStart="18dp"
    android:paddingEnd="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar estudiante"
            android:textStyle="bold"
            android:textSize="16sp"
    android:textColor="@color/texto" />

        <Spinner
            android:id="@+id/spinnerEstudianteInforme"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
    android:background="@drawable/bg_spinner"
    android:paddingStart="18dp"
    android:paddingEnd="40dp" />

        <Button
            android:id="@+id/btnConsultarInforme"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CONSULTAR BOLETÍN"
            android:textStyle="bold"
    android:backgroundTint="@color/accent"
    android:textColor="@color/on_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESULTADOS ACADÉMICOS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="25dp"
            android:paddingBottom="10dp"
    android:textColor="@color/texto" />

        <LinearLayout
            android:id="@+id/contenedorInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnGenerarPdf"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="GENERAR BOLETÍN PDF"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"
    android:backgroundTint="@color/accent"
    android:textColor="@color/on_accent" />

    </LinearLayout>

</ScrollView>
